# ⚠️  PLANTILLA PARA PRODUCCIÓN
# IMPORTANTE:
# 1. NO commitear credenciales reales en Git
# 2. Usar Docker Secrets o variables de entorno en el servidor
# 3. Cambiar todas las contraseñas a valores seguros

# Database
POSTGRES_USER=clinica_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_USE_STRONG_PASSWORD
POSTGRES_DB=clinica_db

# Spring
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/clinica_db
SPRING_DATASOURCE_USERNAME=clinica_user
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_IN_PRODUCTION_USE_STRONG_PASSWORD

# JWT Configuration (OBLIGATORIO cambiar en producción)
# Generar con: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_48_MIN_32_CHARS
JWT_EXPIRATION=86400000

# CORS Configuration
# Lista de orígenes separados por coma
CORS_ALLOWED_ORIGINS=https://tudominio.com,https://www.tudominio.com

# JVM Settings (Producción)
# JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200
